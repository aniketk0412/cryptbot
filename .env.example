# Copy this file to .env and adjust. The paper bot works with NO secrets at all —
# everything below is optional until you go live.

# Jupiter API base. Free tier = lite-api. Paid tier (with key) = api.jup.ag.
JUPITER_BASE_URL=https://lite-api.jup.ag
# JUPITER_API_KEY=

# --- Live trading only (leave blank for paper mode) ---
# NEVER commit a real key. Use a throwaway wallet with limited funds first.
# SOLANA_RPC_URL=
# WALLET_PRIVATE_KEY=
