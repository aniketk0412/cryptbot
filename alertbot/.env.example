# Copy to .env and fill in. The bot runs and prints terminal alerts WITHOUT any of
# this — these are only needed for phone (Telegram) alerts and the AI auditor.

# What to watch (optional overrides; defaults are SOLUSDT / 1h).
# SYMBOL=SOLUSDT
# INTERVAL=1h

# Manual levels (optional): set BOTH to watch your own drawn levels instead of
# the auto-detected range. Best when you've marked an order block / key level.
# RESISTANCE=82.23
# SUPPORT=79.94

# --- Telegram phone alerts ---
# 1. In Telegram, message @BotFather -> /newbot -> copy the token it gives you.
# 2. Paste it below, then message your new bot anything ("hi").
# 3. Run:  npm run tg:chatid   -> it prints your chat id. Paste it below.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- AI Trade Auditor (LLM) — OPTIONAL, FREE ---
# Fires when the circuit breaker trips: sends the last 10 losing trades to
# an LLM for a plain-English diagnosis (advisory only — never auto-applied).
#
# Default model: NVIDIA Nemotron 3 Ultra — 550B params, 1M context window, FREE tier available.
# 1. Sign up at https://build.nvidia.com  (free, no credit card needed)
# 2. Go to: https://build.nvidia.com/nvidia/nemotron-3-ultra-550b-a55b
# 3. Click "Get API Key" and paste it below.
#
LLM_API_KEY=
# LLM_API_URL=https://integrate.api.nvidia.com/v1/chat/completions  # default (Nemotron 3 Ultra 1M context)
# LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b                        # default
#
# To use OpenAI instead:
# LLM_API_URL=https://api.openai.com/v1/chat/completions
# LLM_MODEL=gpt-4o-mini
#
# To use local Ollama (fully offline):
# LLM_API_URL=http://localhost:11434/v1/chat/completions
# LLM_MODEL=llama3
